{
  "name": "budongsan-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "web": "vite --host 127.0.0.1",
    "api": "node server/api.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "fetch:trades": "node scripts/fetch-apt-trades.mjs",
    "check:public-apis": "node scripts/check-public-apis.mjs",
    "generate:apartments": "node scripts/generate-apartment-data.mjs",
    "seed:db": "node scripts/seed-database.mjs --reset",
    "geocode:apartments": "node scripts/geocode-apartments.mjs",
    "fetch:official-prices": "node scripts/fetch-official-prices.mjs",
    "fetch:boundaries": "node scripts/fetch-boundaries.mjs",
    "fetch:han-river": "node scripts/fetch-han-river.mjs",
    "fetch:capital-boundaries": "node scripts/fetch-capital-boundaries.mjs",
    "fetch:trades-db": "node scripts/fetch-trades-db.mjs",
    "crawl:realtyprice": "node scripts/crawl-realtyprice-seoul.mjs",
    "crawl:realtyprice:yongsan:browser": "node scripts/crawl-realtyprice-yongsan-browser.mjs",
    "import:realtyprice-csv": "node scripts/import-realtyprice-csv.mjs",
    "compact:db": "node scripts/compact-database.mjs",
    "build:tiles": "node scripts/build-vector-tiles.mjs",
    "optimize:boundaries": "node scripts/optimize-boundaries.mjs",
    "report:coordinate-quality": "node scripts/report-coordinate-quality.mjs",
    "smoke:search-filter": "node scripts/smoke-search-filter.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.7.3",
    "lucide-react": "latest",
    "maplibre-gl": "^5.24.0",
    "playwright-core": "^1.60.0",
    "pmtiles": "^4.4.1",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/geojson": "^7946.0.16",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "geojson-vt": "^4.0.3",
    "globals": "latest",
    "typescript-eslint": "latest",
    "vt-pbf": "^3.1.3"
  }
}
