{
  "name": "budongsan-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "web": "vite --host 127.0.0.1",
    "api": "node server/api.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "fetch:trades": "node scripts/fetch-apt-trades.mjs",
    "check:public-apis": "node scripts/check-public-apis.mjs",
    "generate:apartments": "node scripts/generate-apartment-data.mjs",
    "seed:db": "node scripts/seed-database.mjs --reset",
    "geocode:apartments": "node scripts/geocode-apartments.mjs",
    "import:vworld": "node scripts/import-vworld-files.mjs",
    "build:complexes": "node scripts/build-complex-shapes.mjs",
    "fetch:boundaries": "node scripts/fetch-boundaries.mjs",
    "fetch:trades-db": "node scripts/fetch-trades-db.mjs",
    "report:coordinate-quality": "node scripts/report-coordinate-quality.mjs",
    "smoke:search-filter": "node scripts/smoke-search-filter.mjs",
    "web:preview": "vite --host 127.0.0.1 --port ${PORT:-5173}",
    "build:pages": "DEPLOY_BASE=/budongsan/ npm run build && node scripts/export-static-api.mjs --out dist/api && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "deploy": "npm run build:pages && gh-pages -d dist --dotfiles",
    "preview:pages": "DEPLOY_BASE=/budongsan/ vite preview --host 127.0.0.1 --port ${PORT:-4173}"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.2.1",
    "es-hangul": "^2.3.8",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.7.3",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "proj4": "^2.20.9",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^25.9.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "gh-pages": "^6.3.0",
    "globals": "latest",
    "typescript-eslint": "latest"
  }
}
